{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AKA",
  "version": "0.1.0",
  "identifier": "com.aka.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AKA · A股分析工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "A股桌面分析工作台（MVP 骨架）",
    "longDescription": "离线、无账户、无云端的 A 股桌面分析软件骨架；行情为模拟数据。"
  }
}
