{
  "name": "aka-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "prebuild": "node scripts/verify_constants.mjs --docs && node scripts/verify_indicator_docs.mjs",
    "build": "tsc --noEmit && vite build",
    "verify:constants": "node scripts/verify_constants.mjs --docs",
    "verify:docs": "node scripts/verify_indicator_docs.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 1421",
    "golden": "cargo test -p indicator-golden -- --nocapture",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
